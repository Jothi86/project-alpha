---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A catalog of games, tools, and projects.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <nav>
          <a class="brand" href={`${base}/`}>Jothi's Workshop</a>
          <a href={`${base}/games/`}>Games</a>
          <a href={`${base}/tools/`}>Tools</a>
          <a href={`${base}/projects/`}>Projects</a>
        </nav>
      </div>
    </header>
    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site">
      <div class="wrap">
        Everything here is free to use. Some things may add optional paid perks later.
      </div>
    </footer>
  </body>
</html>
