---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  collection?: 'games' | 'tools' | 'projects';
}

const {
  title,
  description = 'Games, tools and projects Jothi has built.',
  collection,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Karla:wght@400;700&display=swap"
    />
  </head>
  <body data-collection={collection}>
    <header class="site">
      <div class="wrap">
        <nav>
          <a class="brand" href={`${base}/`}>Project Alpha</a>
          <a href={`${base}/games/`}>Games</a>
          <a href={`${base}/tools/`}>Tools</a>
          <a href={`${base}/projects/`}>Projects</a>
        </nav>
      </div>
    </header>
    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site">
      <div class="wrap">
        Everything here is free to use. Some things may add optional paid perks later.
      </div>
    </footer>
  </body>
</html>
