---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const isVisible = (item: { data: { status: string } }) =>
  item.data.status === 'live' || item.data.status === 'coming-soon';

const games = (await getCollection('games')).filter(isVisible);
const tools = (await getCollection('tools')).filter(isVisible);
const projects = (await getCollection('projects')).filter(isVisible);

const sections = [
  { label: 'Games', href: `${base}/games/`, items: games },
  { label: 'Tools', href: `${base}/tools/`, items: tools },
  { label: 'Projects', href: `${base}/projects/`, items: projects },
];

const recent = [...games, ...tools, ...projects]
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 6);
---
<Base title="Jothi's Workshop">
  <h1>Jothi's Workshop</h1>
  <p class="lead">
    Games, tools, and projects, organized by what they are and what they're for.
    Everything here is free to use.
  </p>

  <h2>Browse by type</h2>
  <div class="grid">
    {sections.map((s) => (
      <a class="card" href={s.href}>
        <h3>{s.label}</h3>
        <p>{s.items.length} published</p>
      </a>
    ))}
  </div>

  {recent.length > 0 && (
    <>
      <h2>Recently published</h2>
      <div class="grid">
        {recent.map((item) => (
          <a class="card" href={`${base}/${item.collection}/${item.id}/`}>
            <h3>{item.data.title}</h3>
            <p>{item.data.summary}</p>
          </a>
        ))}
      </div>
    </>
  )}

  {recent.length === 0 && (
    <div class="empty">Nothing published yet — the first thing to land here shows up automatically.</div>
  )}
</Base>
