---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { gradientFor } from '../../lib/gradient';

export async function getStaticPaths() {
  const items = await getCollection('tools');
  return items.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const initial = item.data.title.trim().charAt(0).toUpperCase();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const hasPreview = Boolean(item.data.cover || item.data.embed);
---
<Base title={`${item.data.title} — Project Alpha`} description={item.data.summary}>
  <div
    class={`hero-thumb${item.data.embed && !item.data.cover ? ' is-embed' : ''}`}
    style={hasPreview ? undefined : { background: gradientFor(item.data.title) }}
  >
    {item.data.cover && <img src={`${base}/${item.data.cover}`} alt="" />}
    {!item.data.cover && item.data.embed && (
      <iframe
        src={item.data.embed}
        loading="lazy"
        title={`Live preview of ${item.data.title}`}
        referrerpolicy="no-referrer"
        sandbox="allow-scripts allow-same-origin allow-forms allow-popups"
      />
    )}
    {!hasPreview && <span class="initial">{initial}</span>}
  </div>

  {item.data.status === 'coming-soon' && <span class="tag accent-tools">Coming soon</span>}
  <h1>{item.data.title}</h1>
  <p class="lead">{item.data.summary}</p>

  <div class="tags">
    <span class="tag accent-tools">{item.data.kind}</span>
    {item.data.tags.map((t) => <span class="tag">{t}</span>)}
  </div>

  {(item.data.links.demo || item.data.links.repo) && (
    <div class="links-row">
      {item.data.links.demo && <a class="cta" href={item.data.links.demo}>Use it</a>}
      {item.data.links.repo && <a class="cta secondary" href={item.data.links.repo}>Source</a>}
    </div>
  )}

  <div class="prose">
    <Content />
  </div>
</Base>
