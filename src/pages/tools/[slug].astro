---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('tools');
  return items.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
---
<Base title={`${item.data.title} — Project Alpha`} description={item.data.summary} collection="tools">
  <div class="item-head">
    {item.data.status === 'coming-soon' && <span class="badge">Coming soon</span>}
    <h1>{item.data.title}</h1>
    <p class="lead">{item.data.summary}</p>
  </div>

  <div class="tags">
    <span class="tag">{item.data.kind}</span>
    {item.data.tags.map((t) => <span class="tag">{t}</span>)}
  </div>

  {(item.data.links.demo || item.data.links.repo) && (
    <p class="item-links">
      {item.data.links.demo && <a href={item.data.links.demo}>Use it</a>}
      {item.data.links.repo && <a href={item.data.links.repo}>Source</a>}
    </p>
  )}

  <Content />
</Base>
