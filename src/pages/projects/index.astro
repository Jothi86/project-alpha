---
import Base from '../../layouts/Base.astro';
import ItemCard from '../../components/ItemCard.astro';
import { getCollection } from 'astro:content';

const items = (await getCollection('projects'))
  .filter((i) => i.data.status === 'live' || i.data.status === 'coming-soon')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Projects — Project Alpha">
  <h1>Projects</h1>
  <p class="lead">Everything else — apps, bots, experiments, write-ups.</p>

  {items.length === 0 && <div class="empty">No projects published yet.</div>}

  <div class="grid">
    {items.map((item) => (
      <ItemCard
        href={`${base}/projects/${item.id}/`}
        title={item.data.title}
        summary={item.data.summary}
        tags={item.data.tags}
        accent="projects"
        comingSoon={item.data.status === 'coming-soon'}
        cover={item.data.cover}
      />
    ))}
  </div>
</Base>
