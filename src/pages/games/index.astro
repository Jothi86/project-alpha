---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const items = (await getCollection('games'))
  .filter((i) => i.data.status === 'live' || i.data.status === 'coming-soon')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Games — Jothi's Workshop">
  <h1>Games</h1>
  <p class="lead">Playable things, from quick prototypes to finished builds.</p>

  {items.length === 0 && <div class="empty">No games published yet.</div>}

  <div class="grid">
    {items.map((item) => (
      <a class="card" href={`${base}/games/${item.id}/`}>
        {item.data.status === 'coming-soon' && <span class="badge">Coming soon</span>}
        <h3>{item.data.title}</h3>
        <p>{item.data.summary}</p>
        <div class="tags">
          {item.data.tags.map((t) => <span class="tag">{t}</span>)}
        </div>
      </a>
    ))}
  </div>
</Base>
